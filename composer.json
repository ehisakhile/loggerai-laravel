{
    "name": "loggerai/laravel",
    "description": "LoggerAI for Laravel: performance monitoring, errors, logs, alerts and user sessions, with AI that explains what went wrong.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "monitoring", "apm", "observability", "errors", "logging", "session replay", "loggerai"],
    "homepage": "https://loggerai.uk",
    "support": {"email": "dev@loggerai.uk"},
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0"
    },
    "suggest": {
        "ext-zlib": "Compresses batches before sending (recommended)."
    },
    "autoload": {
        "psr-4": {"LoggerAI\\Laravel\\": "src/"}
    },
    "extra": {
        "laravel": {
            "providers": ["LoggerAI\\Laravel\\LoggerAIServiceProvider"],
            "aliases": {"LoggerAI": "LoggerAI\\Laravel\\Facades\\LoggerAI"}
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
